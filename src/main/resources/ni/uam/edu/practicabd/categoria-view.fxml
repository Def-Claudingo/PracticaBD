<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="450.0" prefWidth="420.0" spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.uam.edu.practicabd.Controllers.CategoriaController">
    <children>
        <HBox prefHeight="40.0" prefWidth="420.0" style="-fx-background-color: green;">
            <children>
                <Label text="Formulario Categoría" textFill="WHITE">
                    <font>
                        <Font name="System Bold Italic" size="20.0" />
                    </font>
                </Label>
            </children>
            <padding>
                <Insets left="15.0" top="6.0" />
            </padding>
        </HBox>

        <VBox spacing="8.0">
            <children>
                <Label text="Nombre de la categoría:" />
                <TextField fx:id="txtNombre" promptText="Ej. Bebidas, Alimentos..." />
                <CheckBox fx:id="chkActiva" mnemonicParsing="false" selected="true" text="Categoría Activa" />
            </children>
            <padding>
                <Insets left="20.0" right="20.0" top="5.0" />
            </padding>
        </VBox>

        <HBox spacing="10.0">
            <children>
                <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardar" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Guardar" />
                <Button mnemonicParsing="false" onAction="#cerrar" style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-cursor: hand;" text="Cerrar" />
            </children>
            <padding>
                <Insets left="20.0" />
            </padding>
        </HBox>

        <VBox spacing="5.0" VBox.vgrow="ALWAYS">
            <children>
                <Label text="Categorías registradas:" textFill="#475569">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Label>
                <TableView fx:id="tblCategorias" prefHeight="220.0" prefWidth="380.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="colNombre" prefWidth="220.0" text="Nombre" />
                        <TableColumn fx:id="colActiva" prefWidth="80.0" text="Activa" />
                    </columns>
                </TableView>
            </children>
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="5.0" />
            </padding>
        </VBox>
    </children>
</VBox>
